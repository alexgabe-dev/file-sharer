# api.barnus.vizitor.hu — terminate HTTPS and proxy to the Fastify backend on 127.0.0.1:3001.
# Uploads go DIRECTLY from the browser to this server; never proxy upload bytes through Vercel.
# TLS is assumed to be provisioned separately (e.g. Certbot); real certificates/domains are not configured here.
#
# The backend sets an HttpOnly session cookie scoped to .barnus.vizitor.hu (SESSION_COOKIE_DOMAIN)
# so both barnus.vizitor.hu and api.barnus.vizitor.hu share it; nginx passes Set-Cookie through unchanged.
server {
    listen 443 ssl http2;
    server_name api.barnus.vizitor.hu;

    # ssl_certificate     /etc/letsencrypt/live/api.barnus.vizitor.hu/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.barnus.vizitor.hu/privkey.pem;

    # Resumable uploads send ~8 MiB chunks (UPLOAD_CHUNK_SIZE_BYTES) via PUT, so
    # the body limit only needs to exceed one chunk plus framing overhead.
    client_max_body_size 16m;

    # Baseline security headers for the API origin.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        # Pass through the backend's request id for end-to-end correlation.
        proxy_set_header X-Request-Id $request_id;

        # Large direct uploads and streaming media must not be buffered by nginx.
        proxy_request_buffering off;
        proxy_buffering off;

        # Timeouts tuned for large uploads/downloads over slow mobile networks.
        proxy_connect_timeout 30s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;

        # Keep HTTP range headers intact for media streaming.
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
    }
}

