{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run frontend:test && npm run backend:test",
    "frontend:test": "tsc -p backend/tsconfig.frontend-test.json && node --test \"backend/dist-frontend-test/lib/uploads/**/*.test.js\"",
    "backend:dev": "tsx watch backend/src/server.ts",
    "backend:start": "tsx backend/src/server.ts",
    "backend:seed": "tsx backend/src/seed.ts",
    "backend:reconcile": "tsx backend/src/reconcile.ts",
    "backend:migrate": "tsx backend/src/run-migrate.ts",
    "backend:status": "tsx backend/src/status.ts",
    "backend:backup": "tsx backend/src/backup.ts",
    "backend:restore": "tsx backend/src/restore.ts",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:test": "tsc -p backend/tsconfig.test.json && node --test \"backend/dist-test/tests/**/*.test.js\""
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@vercel/analytics": "1.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.10.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.69.0"
  }
}
