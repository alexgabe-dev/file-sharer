PORT=3001
DATABASE_PATH=./data/shared-files.db
FILE_STORAGE_ROOT=./data/storage
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3001

# Operational safety
LOG_LEVEL=info
SHUTDOWN_GRACE_PERIOD_MS=15000
MIN_FREE_DISK_BYTES=1073741824
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=7

# Password gate / sessions
# Production: set ACCESS_PASSWORD_HASH to a bcrypt hash (see docs/DEPLOYMENT.md).
ACCESS_PASSWORD_HASH=
# Development only: plaintext password (hashed at startup).
#ACCESS_PASSWORD=dev-password
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=barnus_session
SESSION_COOKIE_DOMAIN=.barnus.vizitor.hu
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Upload and quota limits
MAX_UPLOAD_BYTES=1073741824
MAX_FILES_PER_SPACE=10000
MAX_SPACE_STORAGE_BYTES=10737418240
UPLOAD_CONCURRENCY=3

# Resumable/chunked uploads
UPLOAD_CHUNK_SIZE_BYTES=8388608
MAX_UPLOAD_CHUNKS=8192
UPLOAD_SESSION_TTL_MS=86400000
UPLOAD_SESSION_CLEANUP_INTERVAL_MS=900000

# Abuse protection
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Temporary upload cleanup
TEMP_FILE_MAX_AGE_MS=3600000
TEMP_CLEANUP_INTERVAL_MS=900000

# Media processing (FFmpeg/ffprobe must be installed on the VPS)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PROCESSING_CONCURRENCY=1
MEDIA_PROCESSING_TIMEOUT_MS=120000
MEDIA_RETRY_DELAY_MS=15000
PROCESSING_MAX_ATTEMPTS=3
THUMBNAIL_MAX_DIMENSION=512
MAX_PROCESSABLE_IMAGE_PIXELS=50000000
MAX_PROCESSABLE_VIDEO_DURATION_SECONDS=86400
